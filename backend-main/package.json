    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/auth.schema.test.ts tests/unit/http-boundary.test.ts tests/unit/openapi.test.ts tests/unit/inventory.schema.test.ts tests/unit/inventory.logic.test.ts tests/unit/rbac.http.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/auth.integration.test.ts tests/integration/docs.integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend API for a school inventory system",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
